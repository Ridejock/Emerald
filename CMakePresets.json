{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug-full",
      "displayName": "Debug (ImGui)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_USE_IMGUI": "ON"
      }
    },
    {
      "name": "profile",
      "displayName": "Profile (Tracy, optimized with debug info)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "EMERALD_PROFILE": "ON"
      }
    },
    {
      "name": "debug-asan",
      "displayName": "Debug (AddressSanitizer)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_ASAN": "ON"
      }
    },
    {
      "name": "debug-ubsan",
      "displayName": "Debug (UndefinedBehaviorSanitizer; GCC/Clang)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_UBSAN": "ON"
      }
    },
    {
      "name": "debug-tsan",
      "displayName": "Debug (ThreadSanitizer; GCC/Clang)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-full", "configurePreset": "debug-full" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "debug-ubsan", "configurePreset": "debug-ubsan" },
    { "name": "debug-tsan", "configurePreset": "debug-tsan" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 600 }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "debug-full", "inherits": "base", "configurePreset": "debug-full" },
    { "name": "profile", "inherits": "base", "configurePreset": "profile" },
    { "name": "debug-asan", "inherits": "base", "configurePreset": "debug-asan" },
    {
      "name": "debug-ubsan",
      "inherits": "base",
      "configurePreset": "debug-ubsan",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" }
    },
    {
      "name": "debug-tsan",
      "inherits": "base",
      "configurePreset": "debug-tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    }
  ]
}
