{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug-full",
      "displayName": "Debug (ImGui)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_USE_IMGUI": "ON"
      }
    },
    {
      "name": "profile",
      "displayName": "Profile (Tracy, optimized with debug info)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "EMERALD_PROFILE": "ON"
      }
    },
    {
      "name": "debug-asan",
      "displayName": "Debug (AddressSanitizer)",
      "inherits": "debug",
      "cacheVariables": {
        "EMERALD_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-full", "configurePreset": "debug-full" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "debug-asan", "configurePreset": "debug-asan" }
  ]
}
